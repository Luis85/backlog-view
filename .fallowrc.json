{
	"$schema": "./node_modules/fallow/schema.json",
	"entry": [
		"src/main.ts",
		"test/harness/page.ts",
		"test/harness/estimation.ts",
		"test/harness/release.ts",
		"test/harness/mywork.ts"
	],
	"dynamicallyLoaded": [
		"styles/**/*.css",
		"test/harness/theme.css",
		"test/harness/obsidian.css"
	],
	"duplicates": {
		"ignore": [
			"test/harness/obsidian.css"
		]
	},
	"usedClassMembers": [
		{
			"extends": "ViewStateSurface",
			"members": [
				"type"
			]
		},
		{
			"extends": "BasesView",
			"members": [
				"type"
			]
		},
		{
			"extends": "AbstractInputSuggest",
			"members": [
				"getSuggestions",
				"renderSuggestion",
				"selectSuggestion"
			]
		},
		{
			"extends": "ValueSuggest",
			"members": [
				"getSuggestions",
				"renderSuggestion",
				"selectSuggestion",
				"valueOf"
			]
		},
		{
			"extends": "FuzzySuggestModal",
			"members": [
				"getItems",
				"getItemText",
				"renderSuggestion",
				"onChooseItem"
			]
		},
		{
			"extends": "PromptModal",
			"members": [
				"onOpen"
			]
		}
	],
	"health": {
		"coverage": "coverage/coverage-final.json",
		"ignore": [
			"test/**"
		]
	},
	"rules": {
		"unused-dev-dependencies": "error",
		"unused-optional-dependencies": "error",
		"unused-class-members": "error",
		"private-type-leaks": "warn"
	},
	"overrides": [
		{
			"files": [
				"test/**"
			],
			"rules": {
				"unused-class-members": "off"
			}
		}
	]
}
