{
	"$schema": "./node_modules/fallow/schema.json",
	"entry": ["src/main.ts", "test/harness/page.ts", "test/harness/estimation.ts", "test/harness/release.ts"],
	"dynamicallyLoaded": ["styles/**/*.css", "test/harness/theme.css", "test/harness/obsidian.css"],
	"duplicates": {
		"ignore": ["test/harness/obsidian.css"]
	},
	// `scopeTree.ts` keeps three names — `foldedPaths`, `toggleFold`, `setAllFolds` — under
	// their OLD (release-only) signatures, each a one-line call into `view/scopeFolds.ts`'s
	// function of the same name (Task 5 of [[Assigned work in the sidebar]]). Every caller
	// names an explicit file, never a barrel, so the collision this rule exists to catch
	// cannot happen here — it is the delegation the extraction is FOR.
	"ignoreExports": [
		{
			"file": "src/view/release/scopeTree.ts",
			"exports": ["foldedPaths", "toggleFold", "setAllFolds"]
		}
	],
	"usedClassMembers": [
		{ "extends": "ViewStateSurface", "members": ["type"] },
		{ "extends": "BasesView", "members": ["type"] },
		{
			"extends": "AbstractInputSuggest",
			"members": ["getSuggestions", "renderSuggestion", "selectSuggestion"]
		},
		{
			"extends": "ValueSuggest",
			"members": ["getSuggestions", "renderSuggestion", "selectSuggestion", "valueOf"]
		},
		{
			"extends": "FuzzySuggestModal",
			"members": ["getItems", "getItemText", "renderSuggestion", "onChooseItem"]
		},
		{
			"extends": "PromptModal",
			"members": ["onOpen"]
		}
	],
	"health": {
		"coverage": "coverage/coverage-final.json",
		"ignore": ["test/**"]
	},
	"rules": {
		"unused-dev-dependencies": "error",
		"unused-optional-dependencies": "error",
		"unused-class-members": "error",
		"private-type-leaks": "warn"
	},
	"overrides": [
		{
			"files": ["test/**"],
			"rules": { "unused-class-members": "off" }
		}
	]
}
