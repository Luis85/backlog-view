{
  "name": "product-backlog-view",
  "version": "0.3.0",
  "description": "Obsidian Bases view that displays notes as a sortable product backlog tree of Epics, Features, PBIs and Tasks with drag-and-drop, inspired by Azure DevOps Boards.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test-build": "tsc -noEmit -skipLibCheck && node test-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test",
    "analyze": "fallow",
    "check": "npm run build && npm run lint && npm run test:coverage && npm run analyze",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "bases",
    "backlog"
  ],
  "author": "Luis85",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "fallow": "^3.10.0",
    "jsdom": "^30.0.1",
    "obsidian": "latest",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
