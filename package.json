{
  "name": "product-backlog-view",
  "version": "0.3.0",
  "description": "Obsidian Bases view that displays notes as a sortable product backlog tree of Epics, Features, PBIs and Tasks with drag-and-drop, inspired by Azure DevOps Boards.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test-build": "tsc -noEmit -skipLibCheck && node test-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test",
    "analyze": "fallow",
    "docs": "node docs-check.mjs",
    "check": "npm run build && npm run lint && npm run test:coverage && npm run analyze && npm run docs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "bases",
    "backlog"
  ],
  "author": "Luis85",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "fallow": "^3.10.0",
    "jsdom": "^30.0.1",
    "obsidian": "^1.13.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^2.0.1",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.0.0",
    "@atlaskit/pragmatic-drag-and-drop-live-region": "^2.0.0"
  }
}
