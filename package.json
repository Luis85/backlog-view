{
	"name": "product-backlog-view",
	"version": "0.10.0",
	"description": "Obsidian Bases view that displays notes as a product backlog: a drag-and-drop tree of Epics, Features, PBIs and Tasks, a kanban board with WIP limits, a roadmap, a release view and a weighted estimation view, inspired by Azure DevOps Boards.",
	"main": "main.js",
	"scripts": {
		"dev": "node scripts/esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck --incremental --tsBuildInfoFile node_modules/.cache/tsc/src.tsbuildinfo && node scripts/esbuild.config.mjs production",
		"typecheck:test": "tsc -p tsconfig.test.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/test.tsbuildinfo",
		"test-build": "tsc -noEmit -skipLibCheck --incremental --tsBuildInfoFile node_modules/.cache/tsc/src.tsbuildinfo && node scripts/test-build.mjs",
		"harness": "node scripts/harness.mjs",
		"perf": "node scripts/perf.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage && node scripts/coverage-floors.mjs",
		"lint": "eslint .",
		"lint:md": "markdownlint-cli2",
		"analyze": "fallow",
		"docs": "node scripts/docs-check.mjs",
		"health": "node scripts/health-collect.mjs && node scripts/health-render.mjs",
		"audit": "npm audit --omit=dev --audit-level=critical",
		"check": "npm run build && npm run typecheck:test && npm run lint && npm run lint:md && npm run test:coverage && npm run analyze && npm run docs",
		"version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
		"clock": "vitest run"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"bases",
		"backlog"
	],
	"author": "Luis85",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.20.4",
		"@typescript-eslint/parser": "^8.70.1",
		"@vitest/coverage-v8": "^4.1.11",
		"esbuild": "^0.28.2",
		"eslint": "^10.11.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"fallow": "^3.28.0",
		"jsdom": "^30.1.1",
		"lucide-static": "^1.48.0",
		"markdownlint-cli2": "^0.23.3",
		"mdast-util-from-markdown": "^2.0.3",
		"mdast-util-gfm-table": "^2.0.0",
		"micromark-extension-gfm-table": "^2.1.2",
		"obsidian": "1.12.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.1",
		"vitest": "^4.1.10",
		"yaml": "^2.9.1"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@atlaskit/pragmatic-drag-and-drop": "^3.0.0",
		"@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.1.0",
		"@atlaskit/pragmatic-drag-and-drop-live-region": "^2.0.0"
	}
}
