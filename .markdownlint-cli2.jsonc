// The Markdown gate. `npm run lint:md`, and the sixth step of `npm run check`.
//
// It reads the documents a PERSON is expected to read: the register under `docs/`, the
// root files, the workflow READMEs, and the three skills this repository wrote. The
// exclusions below carry the scope decision, and ADR 0032 carries why.
//
// **The rules in this file are the CONTRIBUTOR's set, and they stop at `docs/`.** The
// backlog is a vault somebody writes notes in from Obsidian and commits to `main`, where
// CI runs and the release waits on it, so `docs/.markdownlint.jsonc` narrows this set to
// the rules that catch a note losing content rather than a note being typed. That
// file states which and why; nothing below is a rule the backlog owner has to know.
//
// What it gates is Markdown that RENDERS WRONG — a list glued to the paragraph above it,
// a fence with no blank line around it, a table whose row count disagrees with its header,
// a section heading written twice under one parent. What it does not gate is house style:
// `docs-check.mjs` owns the register's shape, and a second tool with an opinion about line
// length or bold lead-ins would be a style argument this project has already settled in
// prose it wrote on purpose.
{
	"globs": [
		"**/*.md",
		"!node_modules",
		// Generated critique output, not a document anybody maintains.
		"!.impeccable",
		// Generated by the `brainstorming` and `writing-plans` skills, and exempt from
		// `docs-check.mjs` for the same reason: these are records of what a session was
		// going to do, not notes this register maintains. Reformatting them rewrites
		// history to no end.
		"!docs/superpowers",
		// The `subagent-driven-development` skill's per-plan scratch: git-ignored ledgers,
		// briefs and agent reports. Same argument as the line above, plus a mechanical one
		// — it is not in the repository, so CI never sees it and only the contributor
		// running the skill would have `npm run check` fail on files nobody can commit.
		"!.superpowers",
		// Vendored agent tooling — third-party skills installed into the tree, read the
		// way `node_modules` is. The three below are this repository's own and are linted.
		"!.claude",
		".claude/skills/adding-backlog-items/**/*.md",
		".claude/skills/decompose-pbi/**/*.md",
		".claude/skills/resolve-pbi/**/*.md"
	],
	"config": {
		"default": true,

		// --- Off, because the prose is deliberate ---

		// The register wraps near 90-100 columns and its tables and long note names go
		// past it. A wrap width is a convention, not a defect, and nothing renders wrong.
		"MD013": false,
		// `**A lead-in sentence.**` opening a paragraph is how every guide and note in
		// this repository states a rule. It is a paragraph, not a heading pretending.
		"MD036": false,
		// Table pipe alignment. The register's tables are written by hand and by script.
		"MD060": false,
		// `<details>` and `<br>` are used on purpose in the READMEs.
		"MD033": false,
		// An ordered list that restarts its numbering reads correctly either way.
		"MD029": false,
		// The three LINE-oriented rules, and they are off for one measured reason: this
		// register wraps its prose near 90 columns, so a `code span`, a `[[wikilink]]` and
		// a **bold run** routinely break across two lines — and a rule that reads a line
		// rather than the parsed document misreads exactly those. ADR 0021 is the same
		// finding one layer down, which is why `docs-check.mjs` is mdast and not patterns.
		// Measured rather than assumed: with these on, `--fix` rewrote
		// `docs/bugs/A hash in a value is a comment the first rewrite erases.md` from
		// "in a plain scalar, ` #` begins a comment" to "`#` begins a comment", which is
		// false — YAML starts a comment at SPACE-hash, and the space is the whole bug. It
		// also read a `#56` inside a wrapped code span as a heading and put a space in it,
		// editing a quoted frontmatter value inside a record of what that value was.
		// A gate that corrupts the evidence it is checking is worse than no gate.
		"MD018": false,
		"MD037": false,
		"MD038": false,
		// Two quoted examples with a blank line between them are TWO quotes, which is what
		// CommonMark renders and what the playbook means. The rule guards against a single
		// quote broken in half, and it cannot tell the two apart.
		"MD028": false,
		// A note opens with frontmatter and then its title; several open with a lead
		// paragraph. Which is right belongs to `docs/README.md`, which states the shapes.
		"MD041": false,
		"MD025": false,

		// --- On, but narrowed to the defect ---

		// Tabs indent code in this repository, so a tab inside a fence is correct. A tab
		// in PROSE is the one that breaks a list's nesting.
		"MD010": { "code_blocks": false },
		// `## Outcome` appears once per note but many times across a document that quotes
		// several. Only a repeat under the same parent is ambiguous.
		"MD024": { "siblings_only": true }
	}
}
